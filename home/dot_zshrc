export SHELL_NAME=zsh

source ~/.config/myrc.d/zsh-evalcache.zsh

# Activate mise tool manager so that cmd_name can be found
_evalcache ~/.local/bin/mise activate $SHELL_NAME

# Install all tools in ~/.config/mise/config.toml at once
# mise install

# Uncomment the following to log timing
# timer=$(($(date +%s%N)/1000000))
function _echo_timer(){
  if [ "$timer" ]; then
    now=$(($(date +%s%N)/1000000))
    elapsed=$(($now-$timer))
    echo "$elapsed: $1" >&2
    timer=$now
  fi
}

if [[ -o interactive ]]; then
  for F in ~/.config/myrc.d/[0-9]-*; do
    if [ -f "$F" ]; then
      CMD_NAME=$(basename "${F#*-}")
      if command -v "$CMD_NAME" &> /dev/null; then
        #echo "Sourcing $F" >&2
        source "$F"
        _echo_timer "$F"
      else
        echo "Skipping $F: command not found: $CMD_NAME" >&2
      fi
    fi
  done
  unset F
  unset CMD_NAME
fi

unset SHELL_NAME
